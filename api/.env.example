# Neon (usar connection string com pooler para a API; direta para migrations)
DATABASE_URL=postgresql://user:password@host/mazari_capital?sslmode=require
PORT=3200

# Cloudflare R2 (storage privado — Data Room, fotos de obra, comprovantes)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=mazaricapital
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
